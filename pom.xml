<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.3.4</version>
    <relativePath/>
  </parent>

  <groupId>io.github.dolow</groupId>
  <artifactId>recon-lens</artifactId>
  <version>0.1.0</version>
  <name>recon-lens</name>
  <description>配置化对账引擎：规则 DSL + 分片并行 + 差异分类 + LLM 归因（同时是一个 MCP server）</description>
  <url>https://github.com/Dolo-w/recon-lens</url>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>Dolo-w</id>
      <name>Dolo-w</name>
      <url>https://github.com/Dolo-w</url>
    </developer>
  </developers>

  <scm>
    <connection>scm:git:https://github.com/Dolo-w/recon-lens.git</connection>
    <developerConnection>scm:git:git@github.com:Dolo-w/recon-lens.git</developerConnection>
    <url>https://github.com/Dolo-w/recon-lens</url>
  </scm>

  <issueManagement>
    <system>GitHub Issues</system>
    <url>https://github.com/Dolo-w/recon-lens/issues</url>
  </issueManagement>

  <properties>
    <java.version>17</java.version>
    <!-- 显式钉 release：父 POM 用的是 ${java.version} 插值，而 IDE 内嵌 Maven 会用 JVM 的
         java.version 系统属性（如 "17.0.20.1"）遮蔽它，导致语言级别回落到 1.5、IDE 构建报"目标 5"。
         写上 release 后与插值无关，IDE / Eclipse / CI 表现一致；命令行 mvn 行为不变。 -->
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <mcp.sdk.version>2.1.0</mcp.sdk.version>
    <!-- 压测用例（@Tag("bench")）默认不跑：mvn test 保持秒级；要跑见 docs/benchmark.md -->
    <surefire.excludedGroups>bench</surefire.excludedGroups>
    <surefire.argLine>-Dfile.encoding=UTF-8</surefire.argLine>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!-- 规则 DSL 用 YAML 表达；显式声明，不依赖传递依赖 -->
    <dependency>
      <groupId>org.yaml</groupId>
      <artifactId>snakeyaml</artifactId>
    </dependency>

    <!-- MCP（Model Context Protocol）官方 Java SDK：把对账能力暴露成 Agent 可直接调用的工具。
         2.x 起上游把制品拆成 mcp-core + 各 JSON 实现，聚合包 mcp 只带 jackson3；
         本项目跑在 Spring Boot 3（Jackson 2）上，所以显式依赖 jackson2 实现，避免多拖一套 Jackson 3。 -->
    <dependency>
      <groupId>io.modelcontextprotocol.sdk</groupId>
      <artifactId>mcp-core</artifactId>
      <version>${mcp.sdk.version}</version>
    </dependency>
    <dependency>
      <groupId>io.modelcontextprotocol.sdk</groupId>
      <artifactId>mcp-json-jackson2</artifactId>
      <version>${mcp.sdk.version}</version>
    </dependency>

    <!-- 文件导入（M7）：用户的原始数据在 CSV/Excel 里。CSV 手写 RFC 4180 解析（不引额外库），
         Excel 用 POI。POI 不在 Spring Boot BOM 里，版本必须显式钉。 -->
    <dependency>
      <groupId>org.apache.poi</groupId>
      <artifactId>poi-ooxml</artifactId>
      <version>5.3.0</version>
    </dependency>

    <!-- 演示默认用 H2；生产用 MySQL（见 application-mysql.yml） -->
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <scope>runtime</scope>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- 包边界断言：agent 与引擎之间必须是单向依赖（见 AgentBoundaryTest）。
         这条约束写在注释里会被慢慢磨掉，写在测试里才会拦住人。 -->
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <version>1.3.0</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <argLine>${surefire.argLine}</argLine>
          <excludedGroups>${surefire.excludedGroups}</excludedGroups>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
